Windows Registry Editor Version 5.00

; PaperNym File Explorer Context Menu Integration (Current User Only)
; Registers right-click shortcuts to rename or inspect academic PDFs without requiring administrator privileges.

; 1. PDF File Context Menu: "Rename with PaperNym"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\PaperNymRename]
@="Rename with PaperNym"
"Icon"="\"%LOCALAPPDATA%\\Programs\\PaperNym\\PaperNym.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\PaperNymRename\command]
@="\"%LOCALAPPDATA%\\Programs\\PaperNym\\papernym-cli.exe\" scan \"%1\""

; 2. PDF File Context Menu: "Inspect with PaperNym"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\PaperNymInspect]
@="Inspect with PaperNym"
"Icon"="\"%LOCALAPPDATA%\\Programs\\PaperNym\\PaperNym.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\PaperNymInspect\command]
@="\"%LOCALAPPDATA%\\Programs\\PaperNym\\papernym-cli.exe\" show \"%1\""

; 3. Directory Context Menu: "Rename PDFs with PaperNym"
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\PaperNymScan]
@="Rename PDFs with PaperNym"
"Icon"="\"%LOCALAPPDATA%\\Programs\\PaperNym\\PaperNym.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\PaperNymScan\command]
@="\"%LOCALAPPDATA%\\Programs\\PaperNym\\papernym-cli.exe\" scan \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\PaperNymScan]
@="Rename PDFs with PaperNym"
"Icon"="\"%LOCALAPPDATA%\\Programs\\PaperNym\\PaperNym.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\PaperNymScan\command]
@="\"%LOCALAPPDATA%\\Programs\\PaperNym\\papernym-cli.exe\" scan \"%V\""
